{
  "name": "cyberlab-studio",
  "version": "0.1.0",
  "private": true,
  "description": "An open, hands-on cybersecurity learning studio: linked lessons, safe in-browser attack-and-defense labs, and graded challenges for college courses.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://gaganpraveen.github.io/cyberlab-studio/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaganpraveen/cyberlab-studio.git"
  },
  "bugs": {
    "url": "https://github.com/Gaganpraveen/cyberlab-studio/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:icons": "node scripts/render-app-icon.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "cmdk": "^1.1.1",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.18.1",
    "react-router": "^8.5.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "sql.js": "^1.15.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
